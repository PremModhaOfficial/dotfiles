# Config syntax crash course
# ==========================
# # The config file consists of simple key-value pairs,
# # separated by equals signs.
# Best looking font config for Iosevka Nerd Font
font-family = "IosevkaTerm Nerd Font"
#font-family = "Victor mono"
# font-family = "Cascadia Code"
# Font Features for Cascadia Code PL - toggle/comment out to enable/disable
# Ligatures (beautiful code-specific ligatures like =>, !=, ==, ->, etc.)
font-feature = "liga"
# Contextual alternates (smarter character rendering based on context)
font-feature = "calt"
# Stylistic set 01 (THIS WAS MAKING IT ITALIC/CURSIVE - DISABLED)
#font-feature = "ss01"
# Stylistic set 02 (more glyph variants)
font-feature = "ss02"
# Stylistic set 03 (additional glyph variants)
font-feature = "ss03"
# Stylistic set 19 (Cascadia-specific alternates)
font-feature = "ss19"
# Stylistic set 20 (Cascadia-specific alternates)
font-feature = "ss20"
# font-style-italic = "Italic"  # DISABLED - was forcing cursive look

font-size = 18
background-opacity = 0.79
background = #000000
background-blur = true
window-padding-balance = true
# font-family = JetBrains Mono NF
alpha-blending = native
# --- Power User Configuration ---

# Font size for better readability and more content on screen
shell-integration = fish
command = /usr/bin/fish
# Minimal window padding for maximum screen real estate
window-padding-x = 1
window-padding-y = 1


# Set a dark, high-contrast color scheme.
# You might want to replace 'default-dark' with a specific theme name
# like 'Dracula', 'Nord', 'Solarized-Dark', etc., if Ghostty supports them.
# Check Ghostty's documentation or themes directory for available options.

# Remove window decorations for a more integrated look
window-decoration = false

# Ghostty uses shaders for rendering, but direct configuration of custom shaders
# is not a common user-facing option in most terminal emulators.
# If Ghostty supports custom shaders, you would likely find options like:
# shader-path = "/path/to/your/shader.glsl"
# render-backend = "opengl" # or "vulkan", "metal"
# Please consult Ghostty's official documentation for details on shader usage.

# Set the cursor style to a block for better visibility

custom-shader = "./cursor_smear_gradient.glsl"
custom-shader-animation = true
cursor-style = block

# --- 1.3.0 Updates ---
notify-on-command-finish = always
notify-on-command-finish-after = 10s
split-preserve-zoom = true


