# herdr config mirror — only configs are versioned.
# Plugin source trees are regenerable via `herdr plugin install` (or
# `update-all.sh`); their embedded .git dirs must never be committed.

# Embedded git repos / plugin source trees (real paths under .config)
**/.git/
.config/herdr/plugins/github/
.config/herdr/plugins/local/
.local/bin/

# Keep the actual pickr config (customized) but drop the rest.
!.config/herdr/plugins/config/pickr/config.toml
.config/herdr/plugins/config/*/config.example.toml

# Runtime state herdr writes into ~/.config/herdr (must never be committed).
# Whole-dir symlink (herdr.nix) points here, so these would otherwise land in
# the repo on every run.
.config/herdr/herdr-*.log
.config/herdr/herdr.sock
.config/herdr/herdr-client.sock
.config/herdr/plugins.json
