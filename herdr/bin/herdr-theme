#!/usr/bin/env bash
# ============================================================================
# herdr-theme — switch the herdr TUI color theme between fluoromachine flavors
# (or any preset .toml in the themes dir).
#
#   herdr-theme                # interactive picker (prompts for a theme)
#   herdr-theme list           # list available themes + current one
#   herdr-theme <name>         # apply a theme (e.g. delta)
#   herdr-theme export         # print the current theme config
#
# It replaces the [theme] (+ [theme.custom]) section in ~/.config/herdr/config.toml
# with the one from themes/<name>.toml, then reloads herdr's config live
# (herdr server reload-config) so the change applies immediately.
# ============================================================================
set -euo pipefail

DOTFILES="${DOTFILES:-$HOME/dotfiles}"
# Prefer the live herdr themes dir (installed alongside herdr's config); fall
# back to the dotfiles source when running straight out of the repo.
if [ -d "$HOME/.config/herdr/themes" ]; then
  THEMES_DIR="${HERDR_THEMES_DIR:-$HOME/.config/herdr/themes}"
else
  THEMES_DIR="${HERDR_THEMES_DIR:-$DOTFILES/herdr/themes}"
fi
CONFIG="${HERDR_CONFIG:-$HOME/.config/herdr/config.toml}"

err() { echo "error: $*" >&2; exit 1; }

# Extract the [theme] + [theme.custom] block (through the next top-level section).
extract_block() {
  local file="$1"
  awk '/^\[theme\]/{on=1; print; next}
       /^\[[a-zA-Z]/{if(on && $0 !~ /^\[theme\./){exit}}
       on{print}' "$file"
}

# Normalize a config's theme block for comparison (strip comments, whitespace).
norm_block() {
  grep -v '^[[:space:]]*#' \
    | sed 's/[[:space:]][[:space:]]*#.*$//' \
    | grep -v '^[[:space:]]*$' \
    | tr -d ' \t'
}

current_theme() {
  [ -f "$CONFIG" ] || { echo "(no herdr config yet)"; return; }
  local live
  live="$(extract_block "$CONFIG" | norm_block)"
  local f name cmp
  for f in "$THEMES_DIR"/*.toml; do
    [ -f "$f" ] || continue
    name="$(basename "$f" .toml)"
    cmp="$(extract_block "$f" | norm_block)"
    if [ "$cmp" = "$live" ]; then echo "$name"; return; fi
  done
  echo "(custom theme — not a saved preset)"
}

list_themes() {
  echo "Available herdr themes:"
  echo "  current: $(current_theme)"
  echo ""
  for f in "$THEMES_DIR"/*.toml; do
    [ -f "$f" ] || continue
    echo "  $(basename "$f" .toml)   ($f)"
  done
}

apply_theme() { # apply_theme <name>
  local theme="$1"
  local preset="$THEMES_DIR/$theme.toml"
  [ -f "$preset" ] || err "no theme '$theme' (expected $preset)"
  local block
  block="$(extract_block "$preset")"
  [ -n "$block" ] || err "no [theme] block in $preset"

  # Merge the theme block into the config: replace any existing [theme] section.
  if [ -f "$CONFIG" ]; then
    cp "$CONFIG" "$CONFIG.bak"
    awk -v newblock="$block" '
      /^\[theme\]/{inblock=1; skip=1; print newblock; next}
      /^\[[a-zA-Z]/{if(inblock && $0 !~ /^\[theme\./){inblock=0; skip=0}}
      !skip{print}
    ' "$CONFIG.bak" > "$CONFIG"
  else
    mkdir -p "$(dirname "$CONFIG")"
    printf '%s\n' "$block" > "$CONFIG"
  fi

  echo "Switched herdr theme to: $theme"

  # Reload herdr live so the change applies without a manual reload.
  if command -v herdr >/dev/null 2>&1; then
    herdr server reload-config >/dev/null 2>&1 && echo "Herdr config reloaded." \
      || echo "Herdr reload skipped (not running). Will apply on next launch."
  else
    echo "herdr CLI not found; change applies on next launch."
  fi
}

case "${1:-}" in
  "" | "pick")
    # Interactive picker: list numbered options and prompt.
    mapfile -t names < <(for f in "$THEMES_DIR"/*.toml; do [ -f "$f" ] || continue; basename "$f" .toml; done)
    [ "${#names[@]}" -gt 0 ] || err "no theme presets found in $THEMES_DIR"
    echo "Select a herdr theme (current: $(current_theme)):"
    for i in "${!names[@]}"; do
      printf '  %2d) %s\n' "$((i+1))" "${names[$i]}"
    done
    printf 'Choice [1-%d]: ' "${#names[@]}"
    read -r sel
    case "$sel" in
      ''|*[!0-9]*) err "invalid selection '$sel'";;
    esac
    idx=$((sel-1))
    [ "$idx" -ge 0 ] && [ "$idx" -lt "${#names[@]}" ] || err "selection out of range"
    apply_theme "${names[$idx]}"
    ;;
  "list" | "ls")
    list_themes
    ;;
  "export")
    [ -f "$CONFIG" ] || err "no herdr config at $CONFIG"
    extract_block "$CONFIG"
    ;;
  *)
    apply_theme "${1:-}"
    ;;
esac
