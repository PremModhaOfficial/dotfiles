(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold yes
)

(defsrc
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

(defvar
  tap-timeout 200
  hold-timeout 200
  left-hand-keys (q w e r t g z x c v b)
  right-hand-keys (y u i o p h n m , . /)
)

(defalias
  ;; Home-row mods (existing - preserved)
  a-ctrl (tap-hold-release-keys $tap-timeout $hold-timeout a lctl $left-hand-keys)
  s-shift (tap-hold-release-keys $tap-timeout $hold-timeout s lsft $left-hand-keys)
  f-meta (tap-hold-release-keys $tap-timeout $hold-timeout f lmet $left-hand-keys)
  d-alt (tap-hold-release-keys $tap-timeout $hold-timeout d lalt $left-hand-keys)
  j-meta (tap-hold-release-keys $tap-timeout $hold-timeout j rmet $right-hand-keys)
  k-alt (tap-hold-release-keys $tap-timeout $hold-timeout k ralt $right-hand-keys)
  l-shift (tap-hold-release-keys $tap-timeout $hold-timeout l rsft $right-hand-keys)
  semicolon-ctrl (tap-hold-release-keys $tap-timeout $hold-timeout ; rctl $right-hand-keys)
  quote-num (tap-hold $tap-timeout $hold-timeout ' (layer-while-held numbers))
  caps-esc-num (tap-hold $tap-timeout $hold-timeout esc (layer-while-held numbers))
  rsft-toggle (tap-dance $tap-timeout (rsft caps))
)



(deflayer base
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  @caps-esc-num @a-ctrl @s-shift @d-alt @f-meta g    h    @j-meta @k-alt @l-shift @semicolon-ctrl @quote-num ret
  lsft z    x    c    v    b    n    m    ,    .    /    @rsft-toggle
  lctl lmet lalt           spc            ralt rmet rctl
)



(deflayer numbers
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    (mwheel-up 50 50) (mwheel-down 50 50) _    _    _    _    _
  _    1    2    3    4    5    6    7    8    9    0    _    _
  _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _              _              _    _    _
)
