{
  "lspconfig": {
    "lua_ls": {
      "Lua": {
        "workspace": {
          "checkThirdParty": false
        },
        "diagnostics": {
          "globals": [
            "vim"
          ]
        }
      }
    },
  },
  "null-ls": {
    "sources": {
      "prettier": {
        "filetypes": [
          "javascript",
          "typescript",
          "json",
          "yaml",
          "markdown"
        ]
      },
      "eslint": {
        "filetypes": [
          "javascript",
          "typescript"
        ]
      }
    }
  },
  "neodev": {
    "library": {
      "enabled": true,
      "plugins": true
    }
  }
}
