{
  "servers": {
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "env": {},
      "shared": true
    },
    "code-graph": {
      "command": "cgc",
      "args": [
        "mcp",
        "start"
      ],
      "env": {
        "NEO4J_USERNAME": "neo4j",
        "NEO4J_PASSWORD": "neo4jneo4j",
        "NEO4J_URI": "bolt://localhost:7687"
      },
      "shared": true,
      "type": "stdio"
    },
    "neo4j-cypher": {
      "command": "uvx",
      "args": [
        "mcp-neo4j-cypher@0.6.0",
        "--transport",
        "stdio"
      ],
      "env": {
        "NEO4J_PASSWORD": "neo4jneo4j",
        "NEO4J_URI": "bolt://localhost:7687",
        "NEO4J_DATABASE": "neo4j",
        "NEO4J_USERNAME": "neo4j"
      },
      "shared": true,
      "type": "stdio"
    },
    "neo4j-memory": {
      "command": "uvx",
      "args": [
        "mcp-neo4j-memory@0.4.5"
      ],
      "env": {
        "NEO4J_URL": "bolt://localhost:7687",
        "NEO4J_DATABASE": "neo4j",
        "NEO4J_PASSWORD": "neo4jneo4j",
        "NEO4J_USERNAME": "neo4j"
      },
      "shared": true,
      "type": "stdio"
    },
    "deepwiki": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote@latest",
        "https://mcp.deepwiki.com/mcp"
      ],
      "env": {},
      "shared": true,
      "type": "stdio"
    },
    "exa": {
      "command": "node9",
      "args": [
        "npx",
        "-y",
        "exa-mcp-server"
      ],
      "env": {
        "EXA_API_KEY": "f3a462b4-1217-44f2-820e-2030fa84ff5d"
      },
      "shared": true,
      "type": "stdio"
    },
    "serena": {
      "command": "serena",
      "args": [
        "start-mcp-server",
        "--context=claude-code",
        "--mode=interactive",
        "--mode=editing",
        "--mode=query-projects"
      ],
      "env": {},
      "shared": true,
      "type": "stdio"
    }
  }
}